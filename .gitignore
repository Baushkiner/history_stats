__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.venv/
venv/

# Кэш ответов SPARQL — восстанавливается повторным запросом
data/cache/

# Архивы, скачанные из файлового каталога ristat.org: в них рядом с таблицей
# лежит документация в PDF, и весят они больше самого слоя. Пересобираются
# командой harvest_errhs.py.
data/raw/ristat/

# Архивы GHCN и приведённый из них ряд: сотни мегабайт, забираются с NOAA
# одной командой (scripts/harvest_weather.py --fetch)
data/raw/meteo/

# Файлы набора по голоду 1891–1892 годов с Harvard Dataverse: шесть
# мегабайт, из них три — панель 1885–1896 годов. Пересобираются одной
# командой (scripts/harvest_famine_1891.py --check), в репозиторий идут
# только записи и полигоны уездов.
data/raw/famine_1891/

# Great Eurasian Drought Atlas с Zenodo: один NetCDF4 на 226 МБ, вся
# Евразия за 1000–2020 годы. Скачивается заново командой
# scripts/harvest_drought_geda.py --check (размер и md5 сверяются).
data/raw/geda/
# Слои сервера карт HURI MAPA (master_admin, master_ethnic, podillya) как
# отдал их ArcGIS REST: около 60 МБ, в основном подробные полигоны 1922, 1927
# и 1928 годов. Пересобираются одной командой (scripts/harvest_huri.py
# --check), в репозиторий идут упрощённая подложка и записи.
data/raw/huri/
# Пакеты воспроизведения с Harvard Dataverse, подключённые 24.10.2026:
# волнения и земство (2 МБ), мобилизация 1914–1916 годов (3 МБ), архив
# Буггле и Нафцигера (27 МБ) с выгрузкой русских названий GeoNames.
# Пересобираются своими сборщиками (`--check`), в репозиторий идут записи.
data/raw/reforms_1851/
data/raw/mobilization_1914/
data/raw/city_population/
# Сожжённые деревни Белоруссии: главная таблица набора Жукова (5 МБ),
# выжимка помесячного файла (сам файл в 291 МБ читается потоком и на диск
# не ложится) и кэш разобранных карточек НАРБ. Пересобираются командой
# scripts/harvest_burned_villages.py --check / --narb-all.
data/raw/burned_villages_by/
# Главная и 411 карточек «Некрополя террора и ГУЛАГа» (en.mapofmemory.org):
# в карточках справки и подписи к снимкам, права на которые не выяснены, —
# в репозиторий идёт только слой. Пересобираются одной командой
# (scripts/harvest_burial_sites_terror.py --fetch), около 70 минут.
data/raw/mapofmemory/

# Крупные выгрузки пересобираются скриптами; в репозиторий идут
# только отчёт и небольшие GeoJSON-слои.
data/out/*.xlsx
data/out/context.jsonl
data/out/jsonl/
data/out/xlsx/

# Рабочие копии параллельных агентов: временные worktree самого репозитория,
# живут только на время задачи и убираются сами.
.claude/worktrees/
# Выборка границ государств только по охвату РИ/СССР (`--region` у
# harvest_cshapes.py и harvest_cliopatria.py) — вспомогательная: с ноября
# 2026 года слоем стал весь мир, а прежняя выборка — его часть
data/out/boundaries/state_borders_region.geojson
data/out/boundaries/state_borders_early_region.geojson

.DS_Store

# Пакет Маркевича, Науменко, Цянь с Zenodo (v3.zip, 12,8 МБ) и main_data.Rdata
# набора Rozenas, Zhukov (5 МБ): пересобираются одной командой
# (scripts/harvest_famine_1933.py --check), в репозиторий идут только записи
# и полигоны районов УССР.
data/raw/famine_1933/
# Страницы справочника «Освобождение городов» с soldat.ru и набор Grunewald
# для сверки дат: около девятисот килобайт, скачиваются заново одной
# командой (scripts/harvest_occupation.py --check); в репозиторий идут
# только записи слоя.
data/raw/occupation_cities/
# Архив GeoPolHist с Zenodo (1,3 МБ, снимок репозитория médialab вместе с
# исходниками визуализации): скачивается заново командой
# scripts/harvest_geopolhist.py --check (размер и md5 сверяются); в
# репозиторий идут только записи слоя.
data/raw/geopolhist/
data/raw/suomen_kylat/
data/raw/geo_ecclesiae/
data/raw/deportations/
# Слои WFS Maa- ja Ruumiamet (около 25 МБ GML) и описи Rahvusarhiiv: листинг
# каталога, шапки 4 034 фондов и файлы 322 приходов (около 65 МБ).
# Пересобираются командой scripts/harvest_estonia.py --fetch; в репозиторий
# идут подложка кирхшпилей и два слоя.
data/raw/maaamet/
data/raw/rahvusarhiiv/
data/raw/wikisource_arkhiv/
