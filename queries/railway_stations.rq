# @layer railway_stations
# @title Железнодорожные станции
# @scope country
# @qid Q55488 железнодорожная станция
# @qid Q55678 остановочный пункт на железной дороге
# @qid Q784159 разъезд
# @qid Q519608 сортировочная станция
# @qid Q1339195 железнодорожный вокзал
#
# Станции с годом открытия. Дорога меняла судьбу села: отход, браки, торговля.
# README называет станцию одной из двух вещей, которые должны лежать рядом с
# фактом, — «ближайшая ярмарка и станция».
#
# `@scope country` означает, что запрос строит движок (`sources/wikidata.py`),
# а не этот файл: сбор идёт в две ступени по государствам-преемникам.
# Прежний вариант — с `SERVICE wikibase:box` поверх `wdt:P31/wdt:P279*` —
# против живого сервиса не выполняется: рамка РИ/СССР слишком велика, и
# запрос упирается в лимит времени. Тело ниже осталось как ручной вариант
# для одной небольшой области; сбором оно не используется.
#
# Почему классов пять. Отбор идёт по `wdt:P31/wdt:P279*`, то есть подклассы
# приходят сами, и называть класс отдельно нужно только там, куда этот путь
# не доходит. Куда доходит, спрошено у сервиса одним запросом — по всем классам,
# которыми в России помечены объекты, привязанные к железнодорожной линии
# (`wdt:P81`), с флагом «подкласс Q55488» у каждого:
#
#   приходят сами    — грузовая станция (Q55493), тупиковая (Q55485),
#     проходная (Q55490), приграничная (Q1402443), обгонный пункт (Q332496),
#     бывшая станция (Q4663385), а заодно и станции метрополитена (Q928830);
#   сами не приходят  — остановочный пункт (Q55678), разъезд (Q784159),
#     сортировочная станция (Q519608), вокзал (Q1339195); они и добавлены.
#
# Сортировочная станция в этом списке — случай особый и поучительный. Связь
# с грузовой станцией у неё есть, то есть формально это подкласс станции, но
# `wdt:` показывает только утверждения лучшего ранга, а лучший ранг у Q519608
# отдан другому родителю — «парку путей» (Q19563580). Путь `wdt:P279*` до
# Q55488 по нему не доходит, и класс приходится называть отдельно. Если ранги
# в Викиданных переставят, лишним он не станет: повтор отсеет `dedupe`.
#
# Отдельного класса «полустанок» в Викиданных не нашлось: среди 73 классов,
# которыми помечены российские объекты на дороге, такого нет — полустанки
# записаны остановочными пунктами и разъездами и приходят вместе с ними.
#
# Вокзал (Q1339195) — здание, а не остановка, и рядом со станцией он даёт
# вторую точку. Взят намеренно: у здания есть год постройки, которого у самой
# станции часто нет, а часть старых вокзалов существует в Викиданных только
# зданием. Спорное не выбрасывается, а помечается: вид объекта приезжает
# в записи (`?typeLabel`), и вокзал в ней отличим от станции.
#
# Станции метрополитена (Q928830) — подкласс станции, отбросить их можно было
# бы только отдельным условием. Не отбрасываются: метро 1935–1960 годов
# попадает в интересующий период, а более позднее с фактом до 1960 года всё
# равно не совпадёт по времени.
#
# Датировка. Станция — объект, а не событие (`@kind` по умолчанию `object`),
# но год открытия лежит у неё не там, где у здания: на выборке в 2003 объекта
# по России дата основания (P571) нашлась у 124 (6%), а дата официального
# открытия (P1619) — у 1291 (64%); вместе 65%. Поэтому вторая ступень
# спрашивает оба свойства и берёт P1619 там, где P571 пуста, — правка в
# `sources/wikidata.py`. На пробе по одной и той же тысяче объектов
# датированных стало 832 вместо 349. Закрытие по-прежнему из P576; дату
# официального закрытия (P3999) на этом слое не мерили.
#
# Сколько их. Проба 23.08.2026 по одной России: 12 013 объектов
# с координатой. Остальные шестнадцать государств считает полный сбор.
SELECT ?item ?itemLabel ?coord ?start ?end ?adminLabel ?typeLabel ?article ?image ?description WHERE {
  VALUES ?cls { wd:Q55488 wd:Q55678 wd:Q784159 wd:Q519608 wd:Q1339195 }
  SERVICE wikibase:box {
    ?item wdt:P625 ?coord .
    bd:serviceParam wikibase:cornerSouthWest "Point(30 55)"^^geo:wktLiteral .
    bd:serviceParam wikibase:cornerNorthEast "Point(42 62)"^^geo:wktLiteral .
  }
  ?item wdt:P31/wdt:P279* ?cls .
  # Как и на второй ступени сбора: у станции заполняют не дату основания,
  # а дату официального открытия. Спрашивать одну P571 — потерять две трети.
  OPTIONAL { ?item wdt:P571 ?founded . FILTER(!isBlank(?founded)) }
  OPTIONAL { ?item wdt:P1619 ?opened . }
  BIND(COALESCE(?founded, ?opened) AS ?start)
  OPTIONAL { ?item wdt:P576 ?end . }
  OPTIONAL { ?item wdt:P131 ?admin . }
  OPTIONAL { ?item wdt:P31 ?type . }
  OPTIONAL { ?item wdt:P18 ?image . }
  OPTIONAL { ?article schema:about ?item ; schema:isPartOf <https://ru.wikipedia.org/> . }
  OPTIONAL { ?item schema:description ?description . FILTER(LANG(?description) = "ru") }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "ru,en". }
}
ORDER BY ?item
