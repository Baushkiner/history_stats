# @layer cemeteries
# @title Кладбища и некрополи
# @scope country
# @qid Q39614 кладбище
#
# Места захоронений, включая иноверческие и военные.
#
# Класс один, и это проверено, а не предположено. Запросом
# `?c wdt:P279* wd:Q39614` подтверждено, что еврейское (Q846659),
# мусульманское (Q2404995), католическое (Q21554881), церковное (Q2749813),
# мемориальное (Q2532223) и бывшее (Q21751045) кладбище, военное
# захоронение (Q1241568) и некрополь (Q200141) — подклассы Q39614:
# `wdt:P31/wdt:P279*` берёт их сам, и отдельные строки только удлинили бы
# первую ступень.
#
# Не взята «могила» (Q173387) — она Q39614 не подчинена, и это верно по
# существу: отдельное захоронение говорит о человеке, а слой отвечает на
# вопрос «где искать записи о месте». Если такие точки понадобятся, это
# отдельный слой, а не расширение этого.
#
# О составе слоя стоит знать заранее: из 10 509 объектов с координатой по
# семнадцати государствам около двух третей приходится на Польшу и лишь
# 474 на Россию. Викиданные о польских кладбищах подробнее прочих, а рамка
# РИ/СССР (`geo.BBOX_RU`, от 18° в. д.) срезает у них западную часть —
# порядка тысячи семисот точек. Оценка слоя дана уже с этой поправкой.
#
# `@scope country` означает, что запрос строит движок (`sources/wikidata.py`),
# а не этот файл: сбор идёт в две ступени по государствам-преемникам.
# Прежний вариант — с `SERVICE wikibase:box` поверх `wdt:P31/wdt:P279*` —
# против живого сервиса не выполняется: рамка РИ/СССР слишком велика, и
# запрос упирается в лимит времени. Тело ниже осталось как ручной вариант
# для одной небольшой области; сбором оно не используется.
SELECT ?item ?itemLabel ?coord ?start ?end ?adminLabel ?typeLabel ?article ?image ?description WHERE {
  SERVICE wikibase:box {
    ?item wdt:P625 ?coord .
    bd:serviceParam wikibase:cornerSouthWest "Point(30 55)"^^geo:wktLiteral .
    bd:serviceParam wikibase:cornerNorthEast "Point(42 62)"^^geo:wktLiteral .
  }
  ?item wdt:P31/wdt:P279* wd:Q39614 .
  OPTIONAL { ?item wdt:P571 ?start . }
  OPTIONAL { ?item wdt:P576 ?end . }
  OPTIONAL { ?item wdt:P131 ?admin . }
  OPTIONAL { ?item wdt:P31 ?type . }
  OPTIONAL { ?item wdt:P18 ?image . }
  OPTIONAL { ?article schema:about ?item ; schema:isPartOf <https://ru.wikipedia.org/> . }
  OPTIONAL { ?item schema:description ?description . FILTER(LANG(?description) = "ru") }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "ru,en,uk,be,pl,lt,lv,et,fi,ro,hy,ka,az,kk,ky,uz,tg,tk,tr,de,sv,fr,nl". }
}
ORDER BY ?item
