# @layer parishes
# @title Церковные приходы
# @scope country
# @qid Q102496 церковный приход
# @filter OPTIONAL { ?item wdt:P571 ?founded . }
# @filter FILTER(!BOUND(?founded) || !isLiteral(?founded) || YEAR(?founded) <= 1960)
# @place ^P5607 ^P127 P159 P276 P131
# @label P708 diocese
# @label P140 religion
# @frame 1897
#
# Приход как единица, а не здание. Метрические книги велись по приходам, и
# вопрос генеалогии звучит «к какому приходу относилось село»; храм отвечает
# на него только наполовину — у прихода бывало по два-три храма, а храм
# переходил из прихода в приход. Здания собирает `churches.rq` (Q16970) и
# `other_faiths.rq`; этот класс туда не входит, двойного счёта нет.
#
# ЧТО ЕСТЬ В ВИКИДАННЫХ (замер 24.10.2026, семнадцать государств-преемников)
# -------------------------------------------------------------------------
# 12 007 приходов по замыканию класса, и почти всё — Польша:
#
#   Польша      11 011     Литва          57     Казахстан, Азербайджан,
#   Финляндия      592     Россия         49     Киргизия, Грузия, Молдавия,
#   Беларусь       190     Украина        98     Узбекистан, Эстония — 14
#
# Латвия, Армения, Таджикистан, Туркменистан — ноль. Эстонских и лифляндских
# кихелькондов здесь нет: они заведены другим классом, «кирхшпиль»
# (Q13358519), не подклассом прихода, и с `P17` чаще Российской империи или
# вовсе без него — см. журнал `docs/DISCOVERY.md`.
#
# ПОДКЛАССЫ проверены замыканием `?c wdt:P279* wd:Q102496`: 57 классов, у 33
# есть объекты по всему миру. В наших странах к самому Q102496 (11 964)
# добавляются православный приход Q108532108 (32, Финляндия), капеллаг
# Q1475157 (6, Финляндия), католический приход Q17143723 (5), Parafia
# personalna Q2072243 (1) и Swedish church abroad Q57413580 (1, Польша).
# Всё это приходы, поэтому берётся замыкание целиком, одним `@qid`. Чужое в
# замыкании — титулярные церкви Рима, миланские «сотни», португальские
# фрегезии, церковные библиотечные округа Швеции — живёт за пределами
# семнадцати государств, и отбор по `P17` его не приводит.
#
# ДАТА. Фильтр отсекает основанное после 1960 года, как у ярмарок
# (`fairs.rq`, там же — зачем `!isLiteral`): 3 586 из 12 007, почти все —
# польские приходы, учреждённые после войны в новых районах и городах.
# Метрик XIX века у них нет, а открытый конец дал бы им вывернутый срок.
# Объекты без даты остаются: неизвестная дата — не поздняя дата. После
# фильтра на первой ступени 8 421 приход: Польша 7 510, Финляндия 544,
# Беларусь 179, Украина 96, Литва 54, Россия 38.
#
# КООРДИНАТА — `@place`. Своя `P625` у прихода есть не всегда, а вне Польши
# почти никогда: у 14 финских приходов из 592, у 27 белорусских из 190, у 5
# российских из 49. Без заимствования слой был бы польским и только. Пути
# в порядке точности, первый найденный выигрывает:
#
#   ^P5607  храм, который сам указывает на приход («находится в
#           церковно-территориальной единице»): 4 925 ссылок у 4 039
#           приходов, больше четырёх тысяч из них — от «христианского
#           храма» Q16970. Точка храма и есть точка прихода;
#   ^P127   храм, владельцем которого записан приход, — так заведены
#           финские церкви: 566 ссылок у 273 приходов;
#   P159    «местонахождение штаб-квартиры» — село или город, где сидит
#           приход: у 1 061 польского и 218 финских;
#   P276    «местонахождение»: десятки;
#   P131    административная единица, но только если это населённый пункт.
#           У польского прихода P131 — чаще всего его село (2 117 раз «село
#           Польши» Q3558970 у приходов без своей точки), у финского —
#           община. Гмина, повят и воеводство отсекаются условием на класс
#           «населённый пункт» (Q486972): точка в середине гмины выглядит
#           достоверно и врёт.
#
# Итог сбора: своя точка у 5 066 записей, P131 — 1 216, P159 — 810, храм
# по P5607 — 555, храм по P127 — 224, P276 — 13. Чужая точка помечается
# `place_level`, путь лежит в `extra.coord_via`. Ни своей, ни чужой точки
# нет у 537 из 8 421 — их сбор считает и печатает, на карту они не встают.
#
# Первая ступень при `@place` координаты не требует — иначе заимствовать
# было бы не для кого. Это дёшево, потому что держит её `P17`, а класс узкий.
#
# ТЕРРИТОРИЯ — `@frame 1897`. Польша и Финляндия как нынешние государства шире
# Царства Польского и Великого княжества, и прямоугольник `geo.BBOX_RU` их не
# разделяет: Краков, Тарнов, Жешув (Галиция) и Вармия (Пруссия) лежат внутри
# него, а Калишская губерния выходит за его 18-й меридиан — восемнадцать её
# приходов прямоугольник выбросил бы. Рамка здесь — полигоны губерний 1897
# года плюс Россия (СССР) из CShapes за 1886–1991 годы (`histctx/frame.py`):
#
#   в губерниях 1897 года             3 211 (Царство Польское 2 559,
#                                            Финляндия 300, прочие 352)
#   в рамке, вне губерний 1897 года      83 (Львов, Закарпатье, Калининград,
#                                            Аланды)
#   вне рамки                          4 590 — помечены `outside_bbox`
#
# Двенадцать точек оказались в море — грубый берег у финских островов;
# им найден берег, и десять из них вернулись в рамку (см. `histctx/frame.py`).
# За рамкой по ошибке контуров остались три финских прихода: Колари и Пелло
# на Торнио CShapes относит к Швеции, Брендё-Кумлинге лежит в море дальше
# 0,3° от берега.
#
# Записи вне рамки остаются в выгрузке, а не выбрасываются: сосед за
# кордоном — тоже контекст (отходники, браки), отчёт их в «годно для
# подбора» не считает. Губерния 1897 года ложится в `region`, подпись P131
# остаётся в `place_text`.
#
# ЕПАРХИЯ (P708) и КОНФЕССИЯ (P140) — в `extra.diocese` и `extra.religion`,
# все значения кроме отклонённых. Епархия есть у 3 018 записей из 3 294 в
# рамке, конфессия — у 1 365. Епархия эта нынешняя: Кельце, Седльце, Плоцк,
# Влоцлавек, Радом, — а не Плоцкая или Сандомирская епархия XIX века; для
# поиска метрик это указатель на нынешний епархиальный архив, не на
# историческую подчинённость.
#
# СВЯЗКИ «ДЕРЕВНЯ → ПРИХОД» в Викиданных нет. Замер всех ссылок на 12 007
# приходов: перечень своих мест (P527) — у 11 приходов, 22 значения; P150 —
# ни у одного; P1001 — у одного, 6 значений. Обратно, от населённых пунктов
# к приходу, — не больше восьми ссылок на все двенадцать тысяч (из них
# P5607 — две). Ссылаются на приход храмы, а не сёла. Слой отвечает «где
# был приход и с какого года», но не «какие сёла к нему относились».
#
# ВРЕМЯ (24.10.2026, с паузой 5 с между обращениями в счёте): первая ступень —
# от 0,5 до 10 с на государство (Польша 7,0 с, Россия 4,1 с), но сервис
# шумит: пустая Армения однажды отвечала 43 с, а промежуток Узбекистан —
# Киргизия в сборе занял 113 с, похоже, с повтором после 504. Вторая
# ступень — девять чанков по тысяче, от 7 до 57 с, всего 140–190 с. Весь
# сбор — 280–318 с за два прогона; рамка по полигонам — 2 с.
#
# Сводные запросы «по всем странам разом» (GROUP BY по замыканию поверх
# семнадцати `P17`, или полтора десятка OPTIONAL-счётчиков на одну страну —
# по Финляндии, Беларуси и Украине) отдают 504 обе попытки подряд, по 65 с
# каждая, — поэтому все замеры выше сняты двумя ступенями: список Q-номеров,
# потом свойства чанками.
#
# `@scope country` означает, что запрос строит движок (`sources/wikidata.py`),
# а не этот файл. Тело ниже — ручной вариант для Царства Польского рамкой
# без заимствования координат; сбором оно не используется.
SELECT ?item ?itemLabel ?coord ?start ?end ?adminLabel ?typeLabel ?article ?image ?description WHERE {
  SERVICE wikibase:box {
    ?item wdt:P625 ?coord .
    bd:serviceParam wikibase:cornerSouthWest "Point(19 50.3)"^^geo:wktLiteral .
    bd:serviceParam wikibase:cornerNorthEast "Point(24.2 54.4)"^^geo:wktLiteral .
  }
  ?item wdt:P31/wdt:P279* wd:Q102496 .
  OPTIONAL { ?item wdt:P571 ?start . }
  FILTER(!BOUND(?start) || !isLiteral(?start) || YEAR(?start) <= 1960)
  OPTIONAL { ?item wdt:P576 ?end . }
  OPTIONAL { ?item wdt:P131 ?admin . }
  OPTIONAL { ?item wdt:P31 ?type . }
  OPTIONAL { ?item wdt:P18 ?image . }
  OPTIONAL { ?article schema:about ?item ; schema:isPartOf <https://ru.wikipedia.org/> . }
  OPTIONAL { ?item schema:description ?description . FILTER(LANG(?description) = "ru") }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "ru,en,uk,be,pl,lt,lv,et,fi,ro,hy,ka,az,kk,ky,uz,tg,tk,tr,de,sv,fr,nl". }
}
ORDER BY ?item
