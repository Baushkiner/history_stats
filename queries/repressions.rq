# @layer repressions
# @title Места репрессий и спецпоселений
# @scope country
# @kind object
# @qid Q40357 тюрьма
# @qid Q2151479 места казней
# @qid Q66307429 место массового убийства
# @qid Q734271 братская могила
# @filter FILTER NOT EXISTS { ?item wdt:P31/wdt:P279* wd:Q2403977 }
# @filter FILTER(?cls != wd:Q734271 || EXISTS {
# @filter   { ?item schema:description ?text } UNION { ?item rdfs:label ?text }
# @filter   FILTER(REGEX(?text, "репресс|террор|расстрел|repress|terror|execut", "i"))
# @filter })
#
# Тюрьмы и пересыльные пункты, расстрельные полигоны, места массовых убийств
# и братские могилы жертв террора. Отвечает на тот же вопрос, что и лагеря:
# куда человек делся между приговором и молчанием в документах, — но с другой
# стороны. Лагерь был там, где работа; тюрьма и пересылка — там, где человека
# держали до этапа, а полигон и могила — там, где след обрывается совсем.
#
# Чего здесь намеренно нет: лагерей
# ---------------------------------
# Слой `gulag_camps` уже собран — 1530 записей лагерных управлений с «Карты
# ГУЛАГа» по справочнику «Мемориала», с координатой, годами работы, видом
# работ и численностью по годам. Повторять их из Викиданных бессмысленно и
# вредно: разметка там беднее, а на карте вышло бы два слоя об одном и том же.
# Поэтому класс «исправительно-трудовой лагерь» (Q2403977) в список @qid не
# входит, и мало того — первая директива @filter выбрасывает объект, если он
# ИТЛ по любому пути наследования. Директива нужна не для красоты: тюрьма и
# лагерное отделение в Викиданных нередко описаны одним элементом сразу двух
# классов, и без явного запрета такой элемент пришёл бы к нам через Q40357.
#
# Сверить два слоя по Q-номеру нельзя: у записей `gulag_camps` его нет
# (`source_id` там — это `<номер карточки>:<номер места>`). Поэтому пересечение
# снимается не сверкой после сбора, а выбором классов до него.
#
# По координате сверять тоже нельзя, и это не отговорка, а проверенный факт.
# Орловский централ в Викиданных стоит на 52.9789, 36.0651; «Карта ГУЛАГа»
# даёт на 52.9791, 36.0653 «Орловский концентрационный лагерь №1» 1919–1922
# годов — потому что лагерь принудительных работ помещался в здании той самой
# губернской каторжной тюрьмы. Точка одна, а записи разные: тюрьма стоит
# с 1840 года, лагерное управление занимало её три года. Выбросить вторую по
# совпадению координаты значило бы потерять именно то, ради чего слои и
# собраны: одна запись объясняет здание, другая — этап. Такие совпадения
# в Орле, Вологде, Иркутске ожидаемы и оставлены намеренно.
#
# Класс «концентрационный лагерь» (Q152081) не объявлен: лагеря периода
# оккупации — отдельная тема со своими источниками, и слой у неё должен быть
# свой. Часть их всё же приходит через дерево подклассов тюрьмы — Викиданные
# считают концлагерь местом заключения, и проба это показала. Выбрасывать их
# не за что: в `gulag_camps` их нет, а для родословной это тот же обрыв записи.
# Так что граница здесь пролегает не по чистоте темы, а по дублированию.
#
# Почему @kind object, а не event
# -------------------------------
# В названии слоя стоят и места, и депортации, то есть и объекты, и события.
# Выбран объект, и вот почему. Тюрьма, полигон и могила существуют во времени:
# у них есть P571 (основание) и P576 (упразднение), и открытая датировка у них
# осмысленна — тюрьма, открытая в 1879 году и не закрытая, стояла и в 1930-м.
# Депортация же — событие, и в слой она не идёт вовсе не из-за директивы:
# у депортаций в Викиданных нет координат (депортация происходит с народом, а
# не с точкой), зато они уже собраны вручную — 19 событий в разделе «Репрессии
# и депортации» файла `data/curated/state_events.json`, с перечнем затронутых
# губерний и подсказкой, что искать в архиве. Точка отправки эшелона — это то,
# чего нет ни у нас, ни в Викиданных; закрыть её могут только «Мемориал» и
# topos.memo.ru (см. журнал `docs/DISCOVERY.md`).
#
# Сито на братских могилах
# ------------------------
# Класс Q734271 в наших границах огромен — только по России 3398 объектов с
# координатами, — но подавляющее большинство из них воинские захоронения
# Великой Отечественной, а не жертвы террора. Взять их целиком значило бы
# подменить слой: под названием «места репрессий» на карту легли бы три тысячи
# могил солдат. Взять их вовсе нельзя тоже — Бутовский полигон размечен именно
# этим классом. Разметка вообще неровная: Куропаты — «место массового
# убийства», а Сандармох не подходит ни под один из четырёх классов, в
# Викиданных он «место памяти» и «кладбище», и придёт в слой кладбищ. Ровной
# разметки здесь ждать не приходится: слой берёт то, что размечено, а
# остальное остаётся долгом перед «Мемориалом».
#
# Отсюда вторая директива @filter: братская могила проходит, если её метка или
# описание говорят о репрессиях, терроре или расстреле. Признак не структурный,
# а словесный, и это его слабое место: могила без русского описания в слой не
# попадёт. Структурного признака у Викиданных здесь просто нет — причина
# захоронения в них не размечена, — а из двух ошибок эта дешевле: пропущенное
# место видно по пустоте, подменённый слой не виден никак. Остальных классов
# сито не касается: тюрьма нужна нам любая, потому что и уголовная ссылка, и
# каторга — тот же контекст «почему запись обрывается».
#
# Две вещи, о которых надо знать, читая этот слой
# -----------------------------------------------
# Первая: сито опирается на переменную `?cls` из движка — её объявляет
# `ids_query` строкой `VALUES ?cls`. Если движок когда-нибудь назовёт её иначе,
# SPARQL не упадёт: сравнение с несвязанной переменной даёт ошибку, а
# `ошибка || EXISTS{…}` — ложь, и сито молча расширится на все классы, оставив
# от слоя одни объекты со словом «репрессии» в описании. Ловит это
# `test_filter_relies_on_the_engine_variable_cls` в `tests/test_repressions.py`.
#
# Вторая: у объекта, где известна только дата упразднения, движок ставит
# началом 1800 год (`rows_to_records`). Для храма это разумно, для тюрьмы,
# закрытой в 1938-м, — нет: запись растянется на век с лишним и всплывёт рядом
# с фактом 1820 года. Правится это в общем для всех слоёв движке, поэтому
# здесь только отмечено, а не исправлено; в выгрузке такие записи видны по
# `date_precision = "part"` при пустом источнике даты основания.
#
# Спецпоселений в Викиданных нет
# ------------------------------
# Спецпосёлки и трудпоселения раскулаченных — самое ценное для этого слоя и
# единственное, чего Викиданные не дают: класс «спецпоселение» (Q2063747)
# существует как понятие, но экземпляров у него ноль. Долг записан в
# `docs/DISCOVERY.md`: закрыть его могут только «Топография террора» и
# «Некрополь террора и ГУЛАГа», где эти места собраны людьми.
#
# `@scope country` означает, что запрос строит движок (`sources/wikidata.py`):
# сбор идёт в две ступени по государствам-преемникам. Тело ниже — ручной
# вариант для одной небольшой области; сбором оно не используется.
SELECT ?item ?itemLabel ?coord ?start ?end ?adminLabel ?typeLabel ?article ?image ?description WHERE {
  SERVICE wikibase:box {
    ?item wdt:P625 ?coord .
    bd:serviceParam wikibase:cornerSouthWest "Point(30 55)"^^geo:wktLiteral .
    bd:serviceParam wikibase:cornerNorthEast "Point(42 62)"^^geo:wktLiteral .
  }
  VALUES ?cls { wd:Q40357 wd:Q2151479 wd:Q66307429 wd:Q734271 }
  ?item wdt:P31/wdt:P279* ?cls .
  FILTER NOT EXISTS { ?item wdt:P31/wdt:P279* wd:Q2403977 }
  # Оба сита повторены здесь дословно: тело файла — это то, что читатель
  # скопирует в WDQS, и без второго сита он получит все братские могилы рамки.
  FILTER(?cls != wd:Q734271 || EXISTS {
    { ?item schema:description ?text } UNION { ?item rdfs:label ?text }
    FILTER(REGEX(?text, "репресс|террор|расстрел|repress|terror|execut", "i"))
  })
  OPTIONAL { ?item wdt:P571 ?start . }
  OPTIONAL { ?item wdt:P576 ?end . }
  OPTIONAL { ?item wdt:P131 ?admin . }
  OPTIONAL { ?item wdt:P31 ?type . }
  OPTIONAL { ?item wdt:P18 ?image . }
  OPTIONAL { ?article schema:about ?item ; schema:isPartOf <https://ru.wikipedia.org/> . }
  OPTIONAL { ?item schema:description ?description . FILTER(LANG(?description) = "ru") }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "ru,en,uk,be,pl,lt,lv,et,fi,ro,hy,ka,az,kk,ky,uz,tg,tk,tr,de,sv,fr,nl". }
}
ORDER BY ?item
