# @layer estates
# @title Усадьбы и имения
# @scope country
# @owner P127
# @qid Q64627814 усадьба
# @qid Q879050 усадебный дом
# @qid Q12292478 поместье
# @qid Q2116450 манор
# @qid Q2066754 мыза
# @qid Q4156067 дворцово-парковый ансамбль
# @filter FILTER NOT EXISTS { VALUES ?notEstate { wd:Q23413 wd:Q875157 wd:Q7415541 wd:Q2880255 wd:Q17006838 wd:Q1406318 wd:Q156362 wd:Q5175541 } ?item wdt:P31/wdt:P279* ?notEstate }
#
# До 1861 года крепостной род привязан не к селу, а к владельцу и имению:
# ревизские сказки составлялись по имениям, и предка ищут через того, кому он
# принадлежал. Отсюда два признака слоя — где стояла усадьба и чьей она была;
# про второй см. «Владелец» ниже.
#
# КЛАССЫ ВЫБРАНЫ ЗАМЕРОМ, А НЕ ПО НАЗВАНИЮ. «Усадьба» в Викиданных — три
# разных класса, и два из них про крестьянский двор, а не про дворянское
# гнездо. Прямой P31 с координатой по восьми государствам-преемникам, где
# усадьбы вообще есть (поиск haswbstatement на www.wikidata.org, август 2026):
#
#   Q64627814 усадьба «комплекс построек и парка»    98   Россия 92
#   Q879050   усадебный дом (manor house)          1322   Финляндия, Польша, Литва, Латвия
#   Q12292478 поместье                              609   Россия 526
#   Q2116450  манор                                 152   Финляндия 105
#   Q2066754  мыза                                 1339   Эстония 785, Латвия 544
#   Q4156067  дворцово-парковый ансамбль            282   Польша 188, Беларусь 70
#
# ЭТО НЕ ОБЪЁМ СЛОЯ. Сбор берёт не сам класс, а замыкание по подклассам
# (`wdt:P31/wdt:P279*` в `ids_query`), а под этими шестью корнями лежит 160
# классов. Замыкание больше прямого P31 в разы, и разница — в основном
# настоящие усадьбы, которых прямой замер по корню не видит:
#
#   Q16974307 польская усадьба (шляхетский двор)   2845   Польша 2837
#   Q1635663  фольварк                              408   Польша 375, Беларусь 28
#   плюс шесть видов мызы — побочная, полумыза, городская, государственная
#
# Насколько это меняет счёт, видно на живой пробе: Эстония (`wdt:P17 wd:Q191`)
# отдаёт 5 634 объекта с координатой против 916 по прямому P31 — эстонские
# мызы описаны в Викиданных до последнего karjamõis, а побочная мыза для
# генеалогии не хуже главной: крестьянин был приписан именно к ней. Ради этого
# корни и взяты корнями.
#
# НО ЗАМЫКАНИЕ ТАЩИТ И ЧУЖОЕ, и без `@filter` слой был бы засорён:
#
#   под «поместьем» лежит весь нынешний туризм — курорт и горнолыжный курорт,
#       санаторий, спа-отель, отель-казино, турбаза, коттеджный посёлок,
#       винодельческое хозяйство. Английское estate свело их с поместьем;
#   под «усадебным домом» лежит замковая родня — шато, Schloss, укреплённый
#       дворец, башенный дом, Алькасар, замки L- и Z-планировки.
#
# Директива `@filter` отсекает обе ветки восемью корнями: замок (Q23413),
# курорт (Q875157), санаторий (Q7415541), курортный отель (Q2880255), лагерь
# отдыха (Q17006838), посёлок отдыха (Q1406318), винодельческое хозяйство
# (Q156362), коттеджный посёлок (Q5175541). Отсечение идёт по такому же
# замыканию, а не по списку классов: иначе завтрашний подвид курорта войдёт
# в слой снова. Эти восемь Q-номеров `--check` не сверяет — он сверяет только
# `@qid`, — поэтому названия выписаны здесь: если номер разойдётся с
# названием, это видно глазами.
#
# ЧТО НЕ ВЗЯТО КОРНЕМ:
#
#   Q1802963  особняк       312, Россия 226 — городской дом, а не имение.
#       Этот класс напрашивался первым и отвергнут замером: почти всё в нём —
#       городские особняки. Его подкласс «загородный дом» (Q16884952) в наших
#       странах пуст, так что сельского через особняк не пришло бы.
#   Q16560    дворец       4437, Польша 4082 — парадная резиденция.
#   Q23413    замок        1034 — укрепление; он же стоит в `@filter`.
#   Q5890494 и Q72030539  — то же русское слово «усадьба» в другом значении:
#       крестьянский двор с постройками (homestead, farmstead). Из 140
#       объектов 126 в Польше — это загроды, а не дворянские гнёзда.
#
# СПОРНОЕ — дворцово-парковый ансамбль (Q4156067), 282 объекта, подклассов
# нет. По определению это дворец с флигелями, и в России им описаны Царицыно,
# Ораниенбаум и Стрельна, то есть резиденции, а не имения. Но 258 объектов из
# 282 лежат в Польше и Белоруссии, где тем же классом описаны магнатские
# имения (Жиличи, Павлиново) — ровно та единица, к которой был приписан
# крепостной западных губерний. Класс взят целиком, и это осознанная потеря
# точности: отделить потом императорские резиденции по полю «Категория»
# нельзя — у объекта обычно несколько значений P31, а `dedupe` оставляет одно,
# какое придёт первым. Два десятка дворцов в слое из тысяч усадеб — цена за
# западные губернии; помечено здесь, а не выброшено молча.
#
# ВЛАДЕЛЕЦ. Правило проекта — персоналии отдельными записями не собираются:
# репозиторий описывает обстановку, а не людей. У имения владелец не человек
# сам по себе, а главный признак места: без имени слой отвечает «где», но не
# отвечает «у кого искать». Поэтому P127 попадает в поле «Действующее лицо»
# (`actor`) той же записи усадьбы — туда же, где у литературного места стоит
# автор, а у снимка Прокудин-Горский. Отдельной записи о человеке не
# возникает, в индекс подбора он не идёт. Включено директивой `@owner P127`;
# остальным слоям это лишнее соединение, и по умолчанию его нет.
#
# В поле лежит список всех владельцев за всё время, без порядка и без дат:
# кто владел усадьбой именно в нужный год, по нему не определить — за этим
# надо идти по ссылке в саму карточку Викиданных, где у P127 стоят
# квалификаторы. Список всё равно отвечает на главный вопрос: чьё это было.
#
# `@scope country` означает, что запрос строит движок (`sources/wikidata.py`),
# а не этот файл: сбор идёт в две ступени по государствам-преемникам. Тело
# ниже осталось как ручной вариант для одной небольшой области — усадебного
# края между Тверью и Ярославлем. Сбором оно не используется и владельцев не
# спрашивает: свернуть их в одно значение умеет движок, а здесь каждый
# владелец дал бы отдельную строку.
SELECT ?item ?itemLabel ?coord ?start ?end ?adminLabel ?typeLabel ?article ?image ?description WHERE {
  SERVICE wikibase:box {
    ?item wdt:P625 ?coord .
    bd:serviceParam wikibase:cornerSouthWest "Point(30 55)"^^geo:wktLiteral .
    bd:serviceParam wikibase:cornerNorthEast "Point(42 62)"^^geo:wktLiteral .
  }
  VALUES ?cls { wd:Q64627814 wd:Q879050 wd:Q12292478 wd:Q2116450 wd:Q2066754 wd:Q4156067 }
  ?item wdt:P31/wdt:P279* ?cls .
  FILTER NOT EXISTS {
    VALUES ?notEstate { wd:Q23413 wd:Q875157 wd:Q7415541 wd:Q2880255
                        wd:Q17006838 wd:Q1406318 wd:Q156362 wd:Q5175541 }
    ?item wdt:P31/wdt:P279* ?notEstate .
  }
  OPTIONAL { ?item wdt:P571 ?start . }
  OPTIONAL { ?item wdt:P576 ?end . }
  OPTIONAL { ?item wdt:P131 ?admin . }
  OPTIONAL { ?item wdt:P31 ?type . }
  OPTIONAL { ?item wdt:P18 ?image . }
  OPTIONAL { ?article schema:about ?item ; schema:isPartOf <https://ru.wikipedia.org/> . }
  OPTIONAL { ?item schema:description ?description . FILTER(LANG(?description) = "ru") }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "ru,en". }
}
ORDER BY ?item
