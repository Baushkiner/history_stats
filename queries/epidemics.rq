# @layer epidemics
# @kind event
# @title Эпидемии
# @scope country
# @qid Q3241045 вспышка эпидемии
# @filter ?item (wdt:P580|wdt:P582|wdt:P585) ?when .
# @filter FILTER(YEAR(?when) <= 1960)
#
# Холера, тиф, оспа, испанка. В метриках видны как всплеск смертей.
#
# `@scope country` означает, что запрос строит движок (`sources/wikidata.py`),
# а не этот файл: сбор идёт в две ступени по государствам-преемникам, а для
# слоёв событий — ещё и по историческим государствам. Тело ниже осталось как
# ручной вариант для одной небольшой области; сбором оно не используется.
#
# Про класс. Объявленный Q3241045 назывался в заголовке «вспышка
# заболевания» — в Викиданных он «вспышка эпидемии»; название исправлено,
# иначе `--check` не пропускал бы сбор. Соседей искать не пришлось: эпидемия
# (Q44512), пандемия (Q12184) и эпизоотия (Q1126331) — все подклассы
# Q3241045, замыкание по `wdt:P279*` берёт их само. То есть двадцать записей,
# которые слой давал при замере, — это не узкий класс, а состояние данных.
#
# Отчего слой был пуст и что с этим сделано:
#
#  1. Отбор шёл только по нынешним государствам. У события `P17` указывает на
#     государство времён события: у Чумного бунта и Кровавого воскресенья —
#     «Российская империя», и на нынешнюю Россию ничего не ведёт. Слои
#     событий теперь обходят и исторические государства
#     (`HISTORICAL_COUNTRIES` в `sources/wikidata.py`).
#  2. Первая ступень требовала `P625`. У вспышки заболевания своей координаты
#     обычно нет — есть `P276`, место события. Теперь координата берётся у
#     места, а запись помечается `confidence = place_level`.
#
# И одно сужение в обратную сторону — `@filter` по дате события до 1960 года.
# Без него слой заполнили бы вспышки COVID-19 по областям: их в Викиданных
# размечено больше, чем всех дореволюционных эпидемий вместе взятых. Проверка
# на соседнем слое бедствий показала пропорцию: 216 записей по России, из них
# до 1961 года — 19. Верхняя граница та же, что у `OPEN_END_YEAR`.
#
# Чего этот слой намеренно не дублирует: четыре холерные эпидемии (1830,
# 1848, 1866, 1892), чума 1770–1772 годов, сыпной тиф 1918–1922 годов и
# «испанка» — они собраны вручную в слое «Указы, реформы и потрясения»
# (`data/curated/state_events.json`) с перечнем губерний. Это события
# губернского и общегосударственного охвата: точки у них нет и быть не может,
# и ставить её в столице губернии — выдумка (`docs/SCHEMA.md`).
#
# Чем всё кончилось — честно. Замер по трём государствам: по нынешней России
# класс даёт 92 объекта и ни одного до 1961 года (сплошь вспышки COVID-19),
# по Российской империи — ноль и с фильтром, и без него, по СССР — три.
# То есть слой из Викиданных не наполняется, и это не недоделка запроса:
# дореволюционных вспышек с координатой и датой там нет. Запрос оставлен —
# он верен и подберёт то, что появится, — но тему держит кураторский слой
# «Указы, реформы и потрясения». Чем наполнять её по-настоящему, записано в
# `docs/DISCOVERY.md`: подборка документов РГИА в Президентской библиотеке,
# нужен OCR.
#
# Что остаётся непокрытым и в принципе. Вспышка, у которой нет ни `P625`, ни
# `P276` на населённый пункт, на карту не встанет: у губернии точку занимать
# нельзя. Её место — территориальная запись со `scope=region` и перечнем
# губерний, как в кураторском слое; движок сбора таких записей пока не
# делает, и это следующий шаг для всей группы «Бедствия и потрясения».
SELECT ?item ?itemLabel ?coord ?start ?end ?adminLabel ?typeLabel ?article ?image ?description WHERE {
  SERVICE wikibase:box {
    ?item wdt:P625 ?coord .
    bd:serviceParam wikibase:cornerSouthWest "Point(30 55)"^^geo:wktLiteral .
    bd:serviceParam wikibase:cornerNorthEast "Point(42 62)"^^geo:wktLiteral .
  }
  ?item wdt:P31/wdt:P279* wd:Q3241045 .
  # У события даты лежат в P580/P582 (начало и конец) или в P585 (дата
  # события целиком). P571/P576 — про здания и учреждения; для эпидемии или
  # восстания они почти всегда пусты, и слой приходит без датировки.
  OPTIONAL { ?item wdt:P580 ?startTime . }
  OPTIONAL { ?item wdt:P582 ?endTime . }
  OPTIONAL { ?item wdt:P585 ?pointInTime . }
  BIND(COALESCE(?startTime, ?pointInTime) AS ?start)
  BIND(COALESCE(?endTime, ?pointInTime) AS ?end)
  OPTIONAL { ?item wdt:P131 ?admin . }
  OPTIONAL { ?item wdt:P31 ?type . }
  OPTIONAL { ?item wdt:P18 ?image . }
  OPTIONAL { ?article schema:about ?item ; schema:isPartOf <https://ru.wikipedia.org/> . }
  OPTIONAL { ?item schema:description ?description . FILTER(LANG(?description) = "ru") }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "ru,en". }
}
ORDER BY ?item
