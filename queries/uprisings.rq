# @layer uprisings
# @kind event
# @title Восстания и волнения
# @scope country
# @qid Q124734 восстание
# @qid Q686984 массовые беспорядки
# @qid Q49776 забастовка
# @qid Q6107280 восстание
# @filter ?item (wdt:P580|wdt:P582|wdt:P585) ?when .
# @filter FILTER(YEAR(?when) <= 1960)
#
# Крестьянские, рабочие и национальные выступления.
#
# `@scope country` означает, что запрос строит движок (`sources/wikidata.py`),
# а не этот файл: сбор идёт в две ступени по государствам-преемникам, а для
# слоёв событий — ещё и по историческим государствам. Тело ниже осталось как
# ручной вариант для одной небольшой области; сбором оно не используется.
#
# Про классы. Здесь, в отличие от бедствий и эпидемий, класс действительно
# был узок — проверено одним запросом по `wdt:P279*`:
#
#   Q686984 «массовые беспорядки» — не подкласс Q124734. Через него приходит
#     и «бунт» (Q124757, 70 языковых разделов), у которого родитель именно
#     Q686984, а не «восстание»; отдельной строкой бунт объявлять не нужно.
#   Q49776 «забастовка» — не подкласс Q124734. Это не мелочь: Кровавое
#     воскресенье (Q185642) и Ленский расстрел (Q578858) в Викиданных —
#     экземпляры забастовки, и слой о рабочих выступлениях без неё теряет
#     самые свои известные события.
#   Q6107280 «восстание» (англ. revolt) — второй элемент с тем же русским
#     названием и не подкласс Q124734. Дублирование в самих Викиданных;
#     объявлены оба, иначе теряется то, что размечено вторым.
#
# Не добавлена «революция» (Q10931): подклассом Q124734 она не является, но
# класс слишком широк — под него идут промышленная и научная революции, а
# крупные революции сами по себе не точка на местности и уже собраны в слое
# «Указы, реформы и потрясения». Кандидат записан в `docs/DISCOVERY.md`.
#
# Отчего слой давал шестнадцать записей и что с этим сделано, помимо классов:
#
#  1. Отбор шёл только по нынешним государствам. У восстания декабристов
#     (Q126306) `P17` — «Российская империя», и на нынешнюю Россию не ведёт
#     ничего: канонический экземпляр класса «восстание» в слой не попадал.
#     Слои событий теперь обходят и исторические государства.
#  2. Первая ступень требовала `P625`. У Чумного бунта (Q4518057) и Кровавого
#     воскресенья своей координаты нет — есть `P276` (Москва,
#     Санкт-Петербург). Теперь координата берётся у места, а запись
#     помечается `confidence = place_level`.
#
# И одно сужение в обратную сторону — `@filter` по дате события до 1960 года.
# Забастовка и массовые беспорядки — классы, которыми размечены и нынешние
# протесты; без границы по дате они вытеснили бы дореволюционные стачки.
# Верхняя граница та же, что у `OPEN_END_YEAR` в `sources/wikidata.py`.
#
# Чего этот слой намеренно не дублирует: Январское восстание 1863–1868 годов
# и крестьянские восстания 1920–1922 годов — они собраны вручную в слое
# «Указы, реформы и потрясения» с перечнем губерний, потому что охват у них
# губернский, а не точечный.
#
# Что остаётся непокрытым. У Тамбовского восстания (Q811250) есть и своя
# координата, и даты, но `P17` не проставлен вовсе — отбор идёт по
# государству, и ни нынешние, ни исторические его не возьмут. А у Кыштымского
# волнения и Лучайского бунта своей координаты нет, и `P276` указывает на
# губернию (Пермскую, Виленскую) — занимать у губернии точку запрещено, она
# выглядит на карте достоверно и врёт. Таким событиям нужна запись со
# `scope=region` и перечнем губерний; это следующий шаг для всей группы, а не
# для одного запроса.
SELECT ?item ?itemLabel ?coord ?start ?end ?adminLabel ?typeLabel ?article ?image ?description WHERE {
  SERVICE wikibase:box {
    ?item wdt:P625 ?coord .
    bd:serviceParam wikibase:cornerSouthWest "Point(30 55)"^^geo:wktLiteral .
    bd:serviceParam wikibase:cornerNorthEast "Point(42 62)"^^geo:wktLiteral .
  }
  ?item wdt:P31/wdt:P279* wd:Q124734 .
  # У события даты лежат в P580/P582 (начало и конец) или в P585 (дата
  # события целиком). P571/P576 — про здания и учреждения; для эпидемии или
  # восстания они почти всегда пусты, и слой приходит без датировки.
  OPTIONAL { ?item wdt:P580 ?startTime . }
  OPTIONAL { ?item wdt:P582 ?endTime . }
  OPTIONAL { ?item wdt:P585 ?pointInTime . }
  BIND(COALESCE(?startTime, ?pointInTime) AS ?start)
  BIND(COALESCE(?endTime, ?pointInTime) AS ?end)
  OPTIONAL { ?item wdt:P131 ?admin . }
  OPTIONAL { ?item wdt:P31 ?type . }
  OPTIONAL { ?item wdt:P18 ?image . }
  OPTIONAL { ?article schema:about ?item ; schema:isPartOf <https://ru.wikipedia.org/> . }
  OPTIONAL { ?item schema:description ?description . FILTER(LANG(?description) = "ru") }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "ru,en". }
}
ORDER BY ?item
