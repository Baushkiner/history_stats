# @layer other_faiths
# @title Мечети, синагоги, кирхи, костёлы
# @scope country
# @qid Q32815 мечеть
# @qid Q34627 синагога
# @qid Q140454931 католический храм
# @qid Q1088552 костёл
# @qid Q56242063 протестантский храм
# @qid Q56242275 лютеранский храм
#
# Неправославные общины. Для многих родов это единственный путь к нужному
# типу метрических записей: раввинат, мечеть, костёл, кирха. Метрики велись
# по вероисповеданию, а не по зданию, поэтому слой и делится по конфессиям.
#
# `@scope country` означает, что запрос строит движок (`sources/wikidata.py`),
# а не этот файл: сбор идёт в две ступени по государствам-преемникам. Прежний
# вариант — с `SERVICE wikibase:box` поверх `wdt:P31/wdt:P279*` — против
# живого сервиса не выполняется. Тело ниже осталось как ручной вариант для
# одной небольшой области; сбором оно не используется. Рамка в нём взята по
# западным губерниям — Литва, Белоруссия, Правобережная Украина, — где
# синагоги, костёлы и кирхи стоят гуще всего. Мечети в неё не попадают:
# одной небольшой рамки на все четыре конфессии не бывает, они и в жизни
# лежали в разных концах страны.
#
# Почему классов шесть, а не больше. Достаточно было бы четырёх корней:
# остальные католические классы («католический приходской храм», «католический
# собор», «фарный костёл», «восточнокатолический» и «грекокатолический храм»)
# — подклассы костёла, а лютеранский, англиканский и реформатский — подклассы
# протестантского храма; `wdt:P279*` берёт их сами собой. Костёл (Q1088552) и
# лютеранский храм (Q56242275) объявлены отдельно нарочно: это те самые костёл
# и кирха из названия слоя, и объявление держит их в поле зрения сверки
# `--check`. Заодно это страховка: «католический храм» (Q140454931) заведён в
# Викиданных недавно, и если связь `костёл → католический храм` кто-нибудь
# оборвёт, костёлы всё равно соберутся.
#
# Что стало с Q1129743. В прежней редакции файла он был объявлен как
# `# @qid Q1129743 ?` — с вопросительным знаком вместо названия, и сверка
# Q-номеров останавливалась на нём, не давая собрать ни один слой. Живая
# проверка: это «филиальная церковь», приписанная к другому приходу, и
# `wdt:P279` ведёт её к костёлу. То есть класс не чужой этому слою, но и
# объявлять его незачем — он и так внутри католического поддерева. Убран
# как избыточный, а не как ошибочный.
#
# Пересечение со слоем `churches`. «Католический храм» и «протестантский
# храм» — подклассы Q16970 «христианский храм», который собирает
# `queries/churches.rq`, так что без разделения костёлы и кирхи попали бы в
# оба слоя. Разделение сделано в пользу этого слоя: слой «Храмы и церкви»
# отвечает на вопрос «где ближайший приход», а этот — на вопрос «где искать
# метрику иноверца», и для второго конфессия и есть смысл слоя. Поэтому
# `churches.rq` сужен директивой `@filter`, которая исключает ровно те четыре
# класса из шести, что ведут к христианскому храму. Мечеть и синагога к нему
# не ведут (проверено) и в сужении не участвуют: лишний класс в `@filter` —
# это лишний обход иерархии на каждом объекте самого большого слоя.
# Списки обязаны сходиться: класс, объявленный здесь и не исключённый там,
# задвоится; исключённый там и не объявленный здесь — пропадёт из обоих
# слоёв. За этим следит `tests/test_other_faiths.py`.
SELECT ?item ?itemLabel ?coord ?start ?end ?adminLabel ?typeLabel ?article ?image ?description WHERE {
  SERVICE wikibase:box {
    ?item wdt:P625 ?coord .
    bd:serviceParam wikibase:cornerSouthWest "Point(23 49)"^^geo:wktLiteral .
    bd:serviceParam wikibase:cornerNorthEast "Point(32 56)"^^geo:wktLiteral .
  }
  VALUES ?cls { wd:Q32815 wd:Q34627 wd:Q140454931 wd:Q1088552 wd:Q56242063 wd:Q56242275 }
  ?item wdt:P31/wdt:P279* ?cls .
  OPTIONAL { ?item wdt:P571 ?start . }
  OPTIONAL { ?item wdt:P576 ?end . }
  OPTIONAL { ?item wdt:P131 ?admin . }
  OPTIONAL { ?item wdt:P31 ?type . }
  OPTIONAL { ?item wdt:P18 ?image . }
  OPTIONAL { ?article schema:about ?item ; schema:isPartOf <https://ru.wikipedia.org/> . }
  OPTIONAL { ?item schema:description ?description . FILTER(LANG(?description) = "ru") }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "ru,en,uk,be,pl,lt,lv,et,fi,ro,hy,ka,az,kk,ky,uz,tg,tk,tr,de,sv,fr,nl". }
}
ORDER BY ?item
