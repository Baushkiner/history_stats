# @layer fairs
# @title Ярмарки и торги
# @scope country
# @qid Q288514 ярмарка
# @qid Q2386997 гостиный двор
# @qid Q2080521 крытый рынок
# @filter ?item wdt:P31 ?cls .
# @filter OPTIONAL { ?item wdt:P571 ?founded . }
# @filter FILTER(!BOUND(?founded) || !isLiteral(?founded) || YEAR(?founded) <= 1960)
#
# Ярмарка обещана в README как то, что должно лежать рядом с фактом из
# метрической книги. Обещание выполняется наполовину, и честнее сказать,
# какая это половина.
#
# Ярмарки как таковой в Викиданных почти нет. Живой счёт 23.08.2026 по
# семнадцати государствам-преемникам: класс «ярмарка» (Q288514) — 26
# объектов, из них с координатой 8, и половина этих восьми — нынешние
# выставки и вернисажи. Исторических ярмарок с координатой четыре на все
# семнадцать стран: Нижегородская (Q2371326), Верхнеудинская, литовский
# Казюк и «Ярмарочные гуляния на Адмиралтейском лугу»; дата есть только
# у Нижегородской — с 1817. Ирбитская (Q1843571, с 1630) и Сорочинская
# координат не имеют вовсе, а первая ступень сбора отбирает по `wdt:P625` —
# без координаты объект в слой не попадёт при всём желании.
#
# Перечень ярмарок с местами и сроками существует только сканами: список
# 1834 года на 1650 с лишним ярмарок и словарь Чулкова 1788 года
# (см. `docs/DISCOVERY.md`).
#
# Поэтому слой собирается вокруг второго значения слова «торг» — места, где
# торговали: гостиный двор и крытый рынок. Это настоящие узлы уездной
# торговли: Гостиный двор в Архангельске (1684), в Казани (1770), в
# Кронштадте (1832), Бессарабский рынок в Киеве (1912), Выборгский рынок
# (1906), Агенскалнский рынок в Риге (1914).
#
# Почему `@filter ?item wdt:P31 ?cls` — то есть только прямой класс, без
# `wdt:P279*`. Транзитивное замыкание по «ярмарке» против живого сервиса не
# выполняется: 23.08.2026 запрос первой ступени по одной России отдал 504
# после 65 секунд для набора «ярмарка + гостиный двор» и для «ярмарка +
# гостиный двор + крытый рынок», а «гостиный двор» в одиночку прошёл за
# доли секунды. Дело не в размере класса, а в его потомках: у «ярмарки»
# дерево подклассов уводит в нынешние выставки и мероприятия, и сервис
# перебирает десятки тысяч объектов, чтобы вернуть единицы.
#
# Прижатие при этом ничего не теряет — по крайней мере здесь. Замыкание
# всегда шире прямого класса (путь нулевой длины входит в `P279*`), поэтому
# вопрос только в том, есть ли у класса подклассы с объектами. Сверено по
# России и гостиному двору: прямой `wdt:P31` и замыкание дают один и тот же
# список из 14 объектов, объект в объект. Для церкви или населённого места
# так делать нельзя — там подклассы и есть слой; здесь классы конечные, и
# прижатие только снимает лишнюю работу с сервиса.
#
# Чего в слое намеренно нет:
#   * Q57305 «выставка-ярмарка» и Q2948561 «место ярмарки» — под ними в
#     наших странах лежат нынешние выставочные комплексы (GameXpo, «Нефть и
#     газ», «Казань Экспо»), к уездному торгу отношения не имеющие;
#   * Q330284 «рынок» и Q219760 «базар» — по нашим странам это в основном
#     советские и нынешние вещевые рынки; исторические крытые рынки лежат
#     под своим классом Q2080521 и собираются.
#
# Фильтр по дате отсекает основанное после 1960 года. Дело не только в том,
# что вещевой рынок 1989 года не про генеалогию: разбор датировки объекта
# дотягивает открытый конец до 1960 года (`OPEN_END_YEAR`), и у такого рынка
# границы вышли бы перевёрнутыми — с 1989 по 1960. Объекты вовсе без даты
# основания фильтр оставляет: неизвестная дата — не поздняя дата. Ради этого
# же в фильтре стоит `!isLiteral`: у Викиданных «дата неизвестна» приходит
# пустым узлом, `YEAR()` на нём даёт ошибку, а ошибка в SPARQL отбрасывает
# строку — то есть молча выкидывала бы как раз тот случай, который мы
# договорились оставлять.
#
# Фильтр стоит на первой ступени и потому не всесилен: у объекта с двумя
# датами основания (построен в 1780-м, перестроен в 1994-м) первую ступень
# проходит строка с ранней датой, а вторая ступень читает P571 заново и может
# взять позднюю. Такие перевёрнутые границы — общая беда разбора, а не этого
# слоя, и чинить их надо в `rows_to_records`, а не здесь.
#
# `@scope country` означает, что запрос строит движок (`sources/wikidata.py`),
# а не этот файл: сбор идёт в две ступени по государствам-преемникам. Тело
# ниже осталось как ручной вариант для одной небольшой области; сбором оно
# не используется.
SELECT ?item ?itemLabel ?coord ?start ?end ?adminLabel ?typeLabel ?article ?image ?description WHERE {
  SERVICE wikibase:box {
    ?item wdt:P625 ?coord .
    bd:serviceParam wikibase:cornerSouthWest "Point(30 55)"^^geo:wktLiteral .
    bd:serviceParam wikibase:cornerNorthEast "Point(42 62)"^^geo:wktLiteral .
  }
  VALUES ?cls { wd:Q288514 wd:Q2386997 wd:Q2080521 }
  ?item wdt:P31 ?cls .
  OPTIONAL { ?item wdt:P571 ?start . }
  FILTER(!BOUND(?start) || !isLiteral(?start) || YEAR(?start) <= 1960)
  OPTIONAL { ?item wdt:P576 ?end . }
  OPTIONAL { ?item wdt:P131 ?admin . }
  OPTIONAL { ?item wdt:P31 ?type . }
  OPTIONAL { ?item wdt:P18 ?image . }
  OPTIONAL { ?article schema:about ?item ; schema:isPartOf <https://ru.wikipedia.org/> . }
  OPTIONAL { ?item schema:description ?description . FILTER(LANG(?description) = "ru") }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "ru,en". }
}
ORDER BY ?item
