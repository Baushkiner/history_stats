# @layer heritage_sites
# @title Памятники истории и архитектуры (ЕГРОКН)
# @scope class
# @has P5381 регистрационный номер ЕГРОКН
# @filter OPTIONAL { ?item wdt:P571 ?founded . FILTER(!isBlank(?founded)) }
# @filter OPTIONAL { ?item wdt:P1619 ?opened . }
# @filter BIND(COALESCE(?founded, ?opened) AS ?start)
# @filter FILTER(BOUND(?start) && isLiteral(?start) && YEAR(?start) <= 1960)
# @id P5381 egrokn
# @skip churches monasteries cemeteries other_faiths estates factories mines railway_stations repressions fairs settlements_wd parishes renamed_places
# @frame 1897
#
# Датированная застройка вокруг факта: дом, училище, больница, пожарная
# каланча, мост, особняк купца, братская могила — объекты, которые стояли
# рядом и дожили до реестра памятников. Для генеалогии это то, что видел
# предок: «в 1899 году в Кириллове уже стояла земская больница 1880-х», и
# то, куда идти: у здания училища, больницы, присутственных мест есть свой
# фонд в архиве.
#
# ОТБОР — по свойству, а не по классу (`@has`): код объекта в Едином
# государственном реестре объектов культурного наследия (P5381) стоит у
# зданий, памятников, братских могил, парков и мостов, и общего класса у
# них нет — «здание» не покрывает могил, «объект» покрывает всё на свете.
# Замер 22.11.2026: объектов с кодом и координатой 52 164, из них с датой
# основания или открытия не позже 1960 года — 26 256 (запрос — 10,3 с).
# Без даты в слой не идёт ничего: недатированный памятник не сопоставить с
# годом факта (условие 2 раздела «Каталог открыт» в docs/CATALOG.md), а
# таких 25 908 — почти половина реестровых объектов в Викиданных.
#
# ДАТА — основание (P571), а если её нет — открытие (P1619), как у станций.
# У братской могилы это год захоронения или установки памятника, у здания —
# год постройки; конец не указан почти ни у кого, и срок открытый — до 1960
# года (`date_precision = open`).
#
# БЕЗ ДУБЛЕЙ — `@skip`: храм, монастырь, усадьба, станция и завод с кодом
# ЕГРОКН уже стоят на карте в своих слоях, и второй их точки здесь быть не
# должно. Отсев по Q-номеру с выгрузками этих слоёв; замер журнала
# (04.11.2026): из 28 006 датированных объектов уже собраны 6 374.
#
# Номер в реестре — в `extra.egrokn` (`@id`): по нему запись находится в
# карточке Минкультуры, а портал открытых данных `opendata.mkrf.ru` из
# среды сбора не отвечает (журнал, записи 23.08 и 24.10.2026).
#
# ТЕРРИТОРИЯ — `@frame 1897`: реестр российский, но Калининградская
# область, Крым и Кавказ лежат в разных губерниях 1897 года или вне их;
# губерния ложится в `region`, подпись P131 — в `place_text`.
#
# Тело ниже — ручной вариант на один небольшой город (Кириллов, 58 объектов
# с кодом ЕГРОКН); сбором оно не используется.
SELECT ?item ?itemLabel ?coord ?start ?egrokn ?typeLabel WHERE {
  ?item wdt:P5381 ?egrokn ;
        wdt:P131 wd:Q153453 ;
        wdt:P625 ?coord .
  OPTIONAL { ?item wdt:P571 ?start . }
  OPTIONAL { ?item wdt:P31 ?type . }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "ru,en". }
}
ORDER BY ?item
