# @layer churches
# @title Храмы и церкви
# @scope country
# @qid Q16970 христианский храм
# @filter MINUS { VALUES ?conf { wd:Q140454931 wd:Q1088552 wd:Q56242063 wd:Q56242275 } ?item wdt:P31 ?conf }
#
# Приходские церкви и соборы. Метрические книги велись по приходам,
# поэтому храм — это прямая привязка предка к месту хранения записей.
#
# `@filter` отдаёт костёлы и кирхи слою `other_faiths`: католический и
# протестантский храм — подклассы Q16970, и без этой строки они собирались бы
# дважды. Обоснование выбора и требование держать оба списка одинаковыми —
# в шапке `queries/other_faiths.rq`, проверка — в `tests/test_other_faiths.py`.
# С карты ничего не пропадает: исключённое собирается соседним слоем.
#
# Размен, на который пришлось пойти. Первая редакция строки поднималась по
# `wdt:P279*` от классов объекта — полнее, но против живого сервиса не
# выполняется: сбор храмов упирался в лимит времени на всех семнадцати
# государствах подряд и давал ноль записей. `MINUS` по прямому `P31` проходит
# за 43 секунды по России (замыкание не проходило вовсе) и даёт 11 850 храмов
# против 11 877 без фильтра. Цена — здание, у которого костёльность записана
# не прямо, а подклассом, останется в этом слое; таких единицы, и лучше так,
# чем пустой слой.
#
# Две особенности строки, обе намеренные.
# Во-первых, `?conf` не связан значениями: так подъём по `wdt:P279*` от классов
# объекта выполняется один раз, а членство проверяется дешёвым `IN`. Связать
# `?conf` четырьмя классами значило бы четыре обхода иерархии на каждом
# объекте — а объектов здесь больше, чем в любом другом слое.
# Во-вторых, условие смотрит на любое значение P31: здание, у которого рядом
# с православным храмом стоит лютеранский, уходит в слой иных конфессий
# целиком. Для генеалогии это верно — вопрос «где метрика» задаётся к
# конфессии, — но знать об этом надо: слой «Храмы и церкви» такие
# перекрещённые здания не показывает.
#
# `@scope country` означает, что запрос строит движок (`sources/wikidata.py`),
# а не этот файл: сбор идёт в две ступени по государствам-преемникам.
# Прежний вариант — с `SERVICE wikibase:box` поверх `wdt:P31/wdt:P279*` —
# против живого сервиса не выполняется: рамка РИ/СССР слишком велика, и
# запрос упирается в лимит времени. Тело ниже осталось как ручной вариант
# для одной небольшой области; сбором оно не используется.
SELECT ?item ?itemLabel ?coord ?start ?end ?adminLabel ?typeLabel ?article ?image ?description WHERE {
  SERVICE wikibase:box {
    ?item wdt:P625 ?coord .
    bd:serviceParam wikibase:cornerSouthWest "Point(30 55)"^^geo:wktLiteral .
    bd:serviceParam wikibase:cornerNorthEast "Point(42 62)"^^geo:wktLiteral .
  }
  ?item wdt:P31/wdt:P279* wd:Q16970 .
  OPTIONAL { ?item wdt:P571 ?start . }
  OPTIONAL { ?item wdt:P576 ?end . }
  OPTIONAL { ?item wdt:P131 ?admin . }
  OPTIONAL { ?item wdt:P31 ?type . }
  OPTIONAL { ?item wdt:P18 ?image . }
  OPTIONAL { ?article schema:about ?item ; schema:isPartOf <https://ru.wikipedia.org/> . }
  OPTIONAL { ?item schema:description ?description . FILTER(LANG(?description) = "ru") }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "ru,en". }
}
ORDER BY ?item
