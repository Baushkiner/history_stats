# @layer mines
# @title Рудники, копи, промыслы
# @scope country
# @qid Q820477 рудник
# @qid Q15104915 месторождение полезных ископаемых
# @qid Q1880708 солеварня
#
# Горные заводы и копи — места отхожих заработков и приписных крестьян.
#
# Прежде здесь стоял один Q820477 с подписью «месторождение полезных
# ископаемых». Подпись была не от того класса: Q820477 — это рудник, сама
# горная выработка, а месторождение — Q15104915, и одно другому не подкласс.
# Объявлены оба. Месторождение — объект геологический, а не рабочий, но на
# местности это то же место: где месторождение описано, там его и
# разрабатывали. Рудник от месторождения после сбора отличается по названию
# («Агаповское месторождение») и обычно по полю `category`; на `category`
# одного полагаться нельзя — оно из P31, а P31 многозначен, и у объекта,
# который заодно памятник, там может оказаться «объект культурного
# наследия».
#
# Плата за месторождения — датировка: у геологического объекта P571 обычно
# нет, и на пробе по России дату имели только 9% записей (у заводов — 81%).
# Вместе с ними приходят и поздние промыслы, вроде газовых месторождений
# 1960-х годов: год у них проставлен, и подбор по времени их отсеет сам.
# Отсекать их директивой `@filter` по году нельзя: вместе с поздними уйдёт
# всё, у чего года нет, — а это как раз старые копи.
#
# Солеварня (Q1880708) — соляные промыслы из описания слоя. Ни фабрике, ни
# руднику она не подкласс: у Q83405 и Q1880708 общий родитель, но это
# соседи по дереву, а не предок с потомком.
#
# Отдельными `@qid` не нужны: шахта (Q4232315), угольная шахта (Q959309),
# соляная шахта (Q40551), карьер (Q113594123), золотой рудник (Q16659538) —
# все подклассы Q820477; нефтяное месторождение (Q211748) — подкласс
# Q15104915. Своего класса в Викиданных нет у копи и прииска: копь покрывает
# рудник, прииск — золотой рудник.
#
# Проверены и не взяты:
#   * горная выработка (Q1550194) — штольни, стволы и шурфы; это части
#     рудника, на карте они удвоили бы одну и ту же точку;
#   * горное предприятие (Q2990216) — компания, а не место работы:
#     координата у неё в лучшем случае от конторы.
#
# Классы этого слоя и слоя `factories` не пересекаются, иначе одна шахта
# попала бы в оба слоя. Проверено дважды: по дереву (`wdt:P279*`) — ни один
# класс рудников не подкласс фабрики и ни один класс заводов не подкласс
# рудника, — и по факту: в пробе по России 414 рудников и 330 заводов, общих
# Q-номеров ноль.
#
# `@scope country` означает, что запрос строит движок (`sources/wikidata.py`),
# а не этот файл: сбор идёт в две ступени по государствам-преемникам.
# Прежний вариант — с `SERVICE wikibase:box` поверх `wdt:P31/wdt:P279*` —
# против живого сервиса не выполняется: рамка РИ/СССР слишком велика, и
# запрос упирается в лимит времени. Тело ниже осталось как ручной вариант
# для одной небольшой области; сбором оно не используется.
SELECT ?item ?itemLabel ?coord ?start ?end ?adminLabel ?typeLabel ?article ?image ?description WHERE {
  SERVICE wikibase:box {
    ?item wdt:P625 ?coord .
    bd:serviceParam wikibase:cornerSouthWest "Point(56 55)"^^geo:wktLiteral .
    bd:serviceParam wikibase:cornerNorthEast "Point(64 62)"^^geo:wktLiteral .
  }
  VALUES ?cls { wd:Q820477 wd:Q15104915 wd:Q1880708 }
  ?item wdt:P31/wdt:P279* ?cls .
  OPTIONAL { ?item wdt:P571 ?start . }
  OPTIONAL { ?item wdt:P576 ?end . }
  OPTIONAL { ?item wdt:P131 ?admin . }
  OPTIONAL { ?item wdt:P31 ?type . }
  OPTIONAL { ?item wdt:P18 ?image . }
  OPTIONAL { ?article schema:about ?item ; schema:isPartOf <https://ru.wikipedia.org/> . }
  OPTIONAL { ?item schema:description ?description . FILTER(LANG(?description) = "ru") }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "ru,en". }
}
ORDER BY ?item
