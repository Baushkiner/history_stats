# @layer admin_units
# @title Губернии, уезды, волости
# @scope class
# @qid Q86622 губерния
# @qid Q1364324 уезд
# @qid Q18867465 уезд Российской империи
# @qid Q687121 волость
# @qid Q7075127 область Российской империи
# @qid Q671370 генерал-губернаторство
# @qid Q4147444 градоначальство
# @qid Q1048652 автономная область
# @filter FILTER(EXISTS { ?item wdt:P571 ?founded . FILTER(YEAR(?founded) <= 1960) }
# @filter        || NOT EXISTS { ?item wdt:P571 ?later . FILTER(YEAR(?later) > 1960) })
#
# Единицы деления с датами учреждения и упразднения: без них не понять,
# в каком архиве лежит дело. Подчинённость менялась, и место хранения
# документа зависит от того, какому уезду волость подчинялась в нужный год.
#
# Почему не Q56061. Прежняя редакция объявляла один класс —
# «административно-территориальная единица». Под него попадает всё: от
# империи до нынешнего сельского поселения. Замер показал порядок: запрос по
# всем государствам не уложился в лимит даже в виде COUNT. Поэтому общий
# класс заменён списком узких — тех, что существовали только в РИ и раннем
# СССР. Q-номера найдены живым запросом по русским меткам, не по памяти;
# в скобках — сколько объектов дала первая ступень на пробе:
#   Q86622   губерния (91)           Q1364324  уезд (92)
#   Q687121  волость (1463)          Q7075127  область РИ (24)
#   Q671370  генерал-губернаторство (2)        Q4147444 градоначальство (1)
#   Q1048652 автономная область (10) Q18867465 уезд РИ (0 сверх уезда)
# Q18867465 объявлен отдельно, хотя все его 78 объектов уже пришли по
# Q1364324: он подкласс уезда. Лишний запрос — плата за то, чтобы это не
# приходилось держать в голове.
#
# Что проверено и не взято. Q4439316 «стан» — класс исторический, но
# объектов с координатой у него сейчас нет: девятый запрос впустую при каждом
# сборе. Появятся — вернуть строкой `# @qid Q4439316 стан`. Наместничество не
# объявлено иначе: класса с такой меткой в Викиданных не нашлось, единицы
# 1775–1796 годов расписаны по губерниям. Это дыра, а не решение.
#
# Почему `@scope class`, а не `country`. Отбор по семнадцати
# государствам-преемникам (`wdt:P17`) для этого слоя не работает: у
# исторической единицы P17 — историческое государство. Замер по классам:
# губерния значится за Российской империей (84), Российской республикой (41),
# РСФСР (35), СССР (30) — и ни разу за нынешней Россией. У 223 волостей P17
# нет вовсе. За нынешними же государствами числятся почти одни балтийские
# единицы. Перечислять исторические государства поимённо — занятие без конца
# (в замере их набралось за двадцать, вплоть до Приамурского земского края),
# поэтому первая ступень идёт без разделения по государствам — по одному
# классу за запрос: восемь узких классов сами по себе достаточный отбор, а
# географическим ситом остаётся рамка РИ/СССР (`histctx.geo.in_bbox`). По
# одному классу — не из осторожности: девять классов в одном `VALUES` без
# опоры на P17 отдают HTTP 504 через 65 секунд, а поодиночке каждый отвечает
# за полсекунды.
#
# Про балтийские единицы отдельно, потому что их много — около 520 из
# полутора тысяч. Латвийский пагаст и литовская волость это та же волость
# Курляндской или Ковенской губернии, дожившая до наших дней под местным
# названием; рамка их не отсекает и отсекать не должна — они внутри
# территории, ради которой слой и собирается, и по ним ищутся балтийские
# метрики. Слой на треть балтийский не потому, что фильтр протёк, а потому
# что в Викиданных эти волости расписаны подробнее прочих.
#
# Почему снято жёсткое требование P571. Прежнее условие
# `?item wdt:P571 ?start . FILTER(YEAR(?start) <= 1960)` требовало известной
# даты учреждения. Замер: из 655 волостей Российской империи ему отвечают
# 106 — остальные 549 год учреждения в Викиданных не имеют и были бы
# потеряны молча. Теперь берётся единица, у которой есть дата учреждения не
# позже 1960 года — или нет даты учреждения вовсе. Отсекается только третье:
# единица, все даты учреждения которой позже 1960 года, то есть нынешний
# муниципалитет реформ 1990-х и 2010-х.
#
# Обе половины условия нужны, и каждая закрывает свой случай. Первая — из-за
# многозначности P571: у волости, основанной в 1861 году и воссозданной в
# 2006-м, дат две, и одного запрета «есть дата после 1960» хватило бы, чтобы
# выбросить её целиком, хотя первая дата — ровно то, ради чего слой
# собирается. Вторая — из-за того, что «дата неизвестна» в Викиданных
# записывается не пустотой, а особым значением: проверка «дат нет вовсе»
# теряла на этом две волости, у которых год учреждения прямо помечен как
# неизвестный. Единица без дат остаётся в слое с пустой датировкой: чего не
# знаем, того не выдумываем.
#
# Что получилось на пробе: 1683 объекта с координатой, у первой тысячи из
# них — 46% с датировкой и 891 с указанием губернии или области; рамка
# РИ/СССР не отсеяла из этой тысячи никого. Названия — Костромская губерния
# (1796–1929), Гродненская (1801–1918), Шушинский уезд (1840–1923),
# Мазовецкая губерния (1837–1844), Приекульская волость (без даты): единицы
# исторические, а даты стоят там, где они в Викиданных есть.
#
# Тело ниже — ручной вариант для одной небольшой области; сбором оно не
# используется (`@scope class` строит запрос движком, см. `sources/wikidata.py`).
SELECT ?item ?itemLabel ?coord ?start ?end ?adminLabel ?typeLabel ?article ?image ?description WHERE {
  SERVICE wikibase:box {
    ?item wdt:P625 ?coord .
    bd:serviceParam wikibase:cornerSouthWest "Point(30 55)"^^geo:wktLiteral .
    bd:serviceParam wikibase:cornerNorthEast "Point(42 62)"^^geo:wktLiteral .
  }
  VALUES ?cls {
    wd:Q86622 wd:Q1364324 wd:Q18867465 wd:Q687121 wd:Q7075127
    wd:Q671370 wd:Q4147444 wd:Q1048652
  }
  ?item wdt:P31/wdt:P279* ?cls .
  FILTER(EXISTS { ?item wdt:P571 ?founded . FILTER(YEAR(?founded) <= 1960) }
         || NOT EXISTS { ?item wdt:P571 ?later . FILTER(YEAR(?later) > 1960) })
  OPTIONAL { ?item wdt:P571 ?start . }
  OPTIONAL { ?item wdt:P576 ?end . }
  OPTIONAL { ?item wdt:P131 ?admin . }
  OPTIONAL { ?item wdt:P31 ?type . }
  OPTIONAL { ?item wdt:P18 ?image . }
  OPTIONAL { ?article schema:about ?item ; schema:isPartOf <https://ru.wikipedia.org/> . }
  OPTIONAL { ?item schema:description ?description . FILTER(LANG(?description) = "ru") }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "ru,en". }
}
ORDER BY ?item
