# @layer newspapers
# @title Газеты
# @scope class
# @qid Q11032 газета
# @filter ?item wdt:P291 ?pubPlace . ?pubPlace wdt:P17 ?pubCountry .
# @filter VALUES ?pubCountry { wd:Q159 wd:Q212 wd:Q184 wd:Q232 wd:Q265 wd:Q874 wd:Q863 wd:Q813 wd:Q230 wd:Q399 wd:Q227 wd:Q217 wd:Q37 wd:Q211 wd:Q191 wd:Q36 wd:Q33 }
# @filter OPTIONAL { ?item wdt:P571 ?founded . }
# @filter FILTER(!BOUND(?founded) || !isLiteral(?founded) || YEAR(?founded) <= 1960)
# @place P291
# @label P291 place
# @label P407 language
# @frame 1897
#
# Где выходила местная газета и в какие годы. Для генеалогии это адрес
# второго после метрической книги источника: объявления о смерти и
# венчании, списки призванных, торги имениями, губернские ведомости с
# назначениями и розыском — всё это печаталось в газете того города, куда
# ездили на ярмарку и в присутствие. Вопрос «была ли в 1905 году газета в
# Житомире и на каком языке» слой и закрывает: место издания, годы, язык.
#
# ОТБОР — по месту издания, а не по государству газеты. `P17` у газеты
# указывает то на Российскую империю, то на СССР, то на нынешнюю страну, а
# то не указан вовсе, и отбор по семнадцати нынешним государствам (`@scope
# country`) терял бы дореволюционную прессу целиком — ту, ради которой слой
# заведён. У места издания (`P291`) `P17` — нынешнее государство города, и
# по нему отбор надёжен. Поэтому `@scope class`: первая ступень идёт одним
# запросом по классу без условия на `P17` газеты, а условие на страну места
# издания приходит строками `@filter`.
#
# КЛАСС — замыкание «газеты» (Q11032) по `wdt:P279*`: ежедневная, вечерняя,
# губернские ведомости, многотиражка, стенгазета, газета на идише. Журналы
# и альманахи (Q41298, Q1002697) не взяты: в них печатали очерки, а не
# объявления о семьях, и с ними слой утонул бы в научных журналах XX века.
#
# ЗАМЕР 22.11.2026: первая ступень — 1 896 газет за 22,7 с, после фильтра
# даты. Фильтр отсекает основанное после 1960 года (как у приходов, см.
# `parishes.rq`, там же — зачем `!isLiteral`); газета без даты основания
# остаётся: неизвестная дата — не поздняя дата.
#
# КООРДИНАТА — `@place P291`: своей точки у газеты нет, она берётся у
# населённого пункта, где газета издавалась, и запись помечается
# `place_level` (точка — город, а не редакция). Место-губерния или область
# точки не даёт: путь требует класс «населённый пункт», как у приходов.
# Подпись места (`place`) и язык издания (`language`) — в `extra`.
#
# ТЕРРИТОРИЯ — `@frame 1897`: губерния 1897 года ложится в `region`, газеты
# Кракова, Львова до 1939 года и Варшавы — в рамке или вне её по полигонам,
# а не по прямоугольнику; вне рамки — `outside_bbox`, запись остаётся.
#
# Тело ниже — ручной вариант для одного города; сбором оно не используется.
SELECT ?item ?itemLabel ?coord ?start ?end ?placeLabel WHERE {
  VALUES ?place { wd:Q1899 }
  ?item wdt:P31/wdt:P279* wd:Q11032 ;
        wdt:P291 ?place .
  ?place wdt:P625 ?coord .
  OPTIONAL { ?item wdt:P571 ?start . }
  OPTIONAL { ?item wdt:P576 ?end . }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "ru,en,uk,pl". }
}
ORDER BY ?item
