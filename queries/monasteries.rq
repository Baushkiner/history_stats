# @layer monasteries
# @title Монастыри и пустыни
# @scope country
# @qid Q44613 монастырь
# @qid Q1693568 скит
#
# Монастыри, лавры, пустыни: землевладение, паломничество, призрение.
#
# Классов два, а не один. Проверено запросом `?c wdt:P279* wd:Q44613`:
# лавра (Q824786), православный (Q11784935), пещерный (Q106435710),
# разрушенный (Q1701174) и бывший (Q96371565) монастырь и даже дацан
# (Q2567370) — подклассы Q44613, и `wdt:P31/wdt:P279*` берёт их сам.
# А скит (Q1693568) этой ветви не подчинён — по России это 26 объектов
# с координатой, монастырские и старообрядческие поселения: без своей
# строки они бы в сбор не попали вовсе.
#
# Класс «пустынь» (Q4384142) тоже вне ветви, и всё же не объявлен: в нём
# семь объектов на все Викиданные, из них два с координатой. Пустыни в слой
# приходят не через него, а через Q44613 — Оптина пустынь (Q1225920)
# объявлена православным монастырём, как и почти все остальные. Каждый класс
# в первой ступени — это ещё одно замыкание `wdt:P279*` на каждую из
# семнадцати стран, а запрос по России и так идёт близко к лимиту времени;
# платить этим за два объекта не стоит. Если класс наполнится, строка
# добавляется одной правкой.
#
# Про лимит времени это не фигура речи: первая ступень по России со вторым
# классом занимает десятки секунд и при загруженном сервисе обрывается на
# середине ответа — в журнале сбора это `Россия: ОШИБКА`. Потерять страну
# хуже, чем потерять скиты, так что если обрыв станет постоянным, вторая
# строка убирается, а 26 объектов остаются долгом.
#
# `@scope country` означает, что запрос строит движок (`sources/wikidata.py`),
# а не этот файл: сбор идёт в две ступени по государствам-преемникам.
# Прежний вариант — с `SERVICE wikibase:box` поверх `wdt:P31/wdt:P279*` —
# против живого сервиса не выполняется: рамка РИ/СССР слишком велика, и
# запрос упирается в лимит времени. Тело ниже осталось как ручной вариант
# для одной небольшой области; сбором оно не используется.
SELECT ?item ?itemLabel ?coord ?start ?end ?adminLabel ?typeLabel ?article ?image ?description WHERE {
  SERVICE wikibase:box {
    ?item wdt:P625 ?coord .
    bd:serviceParam wikibase:cornerSouthWest "Point(30 55)"^^geo:wktLiteral .
    bd:serviceParam wikibase:cornerNorthEast "Point(42 62)"^^geo:wktLiteral .
  }
  VALUES ?cls { wd:Q44613 wd:Q1693568 }
  ?item wdt:P31/wdt:P279* ?cls .
  OPTIONAL { ?item wdt:P571 ?start . }
  OPTIONAL { ?item wdt:P576 ?end . }
  OPTIONAL { ?item wdt:P131 ?admin . }
  OPTIONAL { ?item wdt:P31 ?type . }
  OPTIONAL { ?item wdt:P18 ?image . }
  OPTIONAL { ?article schema:about ?item ; schema:isPartOf <https://ru.wikipedia.org/> . }
  OPTIONAL { ?item schema:description ?description . FILTER(LANG(?description) = "ru") }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "ru,en,uk,be,pl,lt,lv,et,fi,ro,hy,ka,az,kk,ky,uz,tg,tk,tr,de,sv,fr,nl". }
}
ORDER BY ?item
