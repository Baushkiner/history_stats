# @layer settlements_wd
# @title Населённые места: год основания
# @scope country
# @qid Q515 город
# @filter ?item wdt:P571 ?start .
# @filter FILTER(YEAR(?start) <= 1960)
#
# Второй источник к населённым местам. Первый — GeoNames: слой `settlements`,
# 17 523 точки, сборщик `scripts/harvest_geonames.py`. Он даёт скелет карты,
# но года основания в наборе нет вовсе, и по времени такое место не подобрать.
# Здесь берётся ровно то, чего там не хватает, — датировка.
#
# Почему у запроса свой slug, а не прежний `settlements`. Слой пишется в файл
# по slug'у (`data/out/geojson/<slug>.geojson`), и по нему же запись получает
# источник и лицензию из `registry.py`. Один slug на два источника означал бы
# две беды сразу: сбор из Викиданных затирает собранный слой GeoNames, а его
# записи получают чужие права — CC BY 4.0 GeoNames вместо CC0 Викиданных.
# Условие 3 каталога («права») требует обратного: у каждой записи стоит её
# собственный источник. Поэтому slug отдельный, файл запроса переименован под
# него, а сведение двух слоёв по координате и названию — отдельная работа,
# и делается она после сбора, а не подменой файла.
#
# Требование P571 — не оптимизация, а смысл слоя: место без даты здесь не
# нужно, оно уже есть в GeoNames. Первая ступень сама `?start` не связывает,
# поэтому обе строки — и связывание, и FILTER — заданы директивами `@filter`
# целиком. Верхняя граница 1960 — конец интересующего периода: города,
# основанные позже (наукограды, нефтяные и заводские посёлки 1970-х), к
# генеалогическому поиску отношения уже не имеют.
#
# Почему класс «город» (Q515), а не «населённый пункт» (Q486972). Q486972
# против живого сервиса не собирается — это измерено, а не предположено
# (все замеры — 23.08.2026, первая ступень по России):
#   * Q486972 с требованием P571: ответ обрывается на 25 367-й строке —
#     сервис не уложился в свой лимит времени и обрезал поток на середине,
#     разбор падает на неполном JSON;
#   * то же с подсказкой `hint:Prior hint:runFirst true` на P571 — HTTP 504
#     за 65 с: подсказка меняет план, но не порядок величины работы;
#   * без замыкания вовсе (`wdt:P31` напрямую, счёт по классам) — HTTP 502
#     за 63 с: дорого не замыкание, а сам перебор российских объектов
#     с координатой и датой;
#   * дешёвый вариант (вместо P571 требовать P576, «упразднён») отвечает за
#     13 с, но даёт 1357 объектов на всю Россию, из них с годом основания
#     до 1960 года — 13%, и половина этих 13% — монастыри и памятники
#     архитектуры: в Викиданных они тоже подклассы населённого пункта.
# Класс «город» держит обе ступени за секунды (4 с и 6 с) и даёт то, ради
# чего слой заводился: губернские и уездные города с годом основания —
# 1031 город по семнадцати государствам, больше всего на Украине (319),
# в Польше (296) и в России (176).
#
# Оговорка про древние города: у 22 из 176 российских городов дата основания
# раньше 1000 года (Псков — 903, Смоленск — 863, Дербент — 438, Керчь — VII век
# до н. э.), и общий разбор такие даты отбрасывает: `_year` в
# `sources/wikidata.py` принимает только 1000–2100. Запрос тут ни при чём —
# в ответе дата есть у всех 176; на карту эти города придут без года.
#
# Сёла и деревни остаются за границей слоя — не потому, что не нужны, а
# потому, что класс целиком сервис не отдаёт. Расширять слой надо узкими
# классами (посёлок городского типа, местечко, бывший населённый пункт),
# каждый со своим `@qid`, своей сверкой и своим замером: класс, который не
# уложится в лимит, обрушит первую ступень целиком.
#
# `@scope country` означает, что запрос строит движок (`sources/wikidata.py`),
# а не это тело: сбор идёт в две ступени по государствам-преемникам.
# Прежний вариант — с `SERVICE wikibase:box` поверх `wdt:P31/wdt:P279*` —
# против живого сервиса не выполняется: рамка РИ/СССР слишком велика, и
# запрос упирается в лимит времени. Тело ниже осталось как ручной вариант
# для одной небольшой области; сбором оно не используется.
SELECT ?item ?itemLabel ?coord ?start ?end ?adminLabel ?typeLabel ?article ?image ?description WHERE {
  SERVICE wikibase:box {
    ?item wdt:P625 ?coord .
    bd:serviceParam wikibase:cornerSouthWest "Point(30 55)"^^geo:wktLiteral .
    bd:serviceParam wikibase:cornerNorthEast "Point(42 62)"^^geo:wktLiteral .
  }
  ?item wdt:P31/wdt:P279* wd:Q515 .
  ?item wdt:P571 ?start .
  FILTER(YEAR(?start) <= 1960)
  OPTIONAL { ?item wdt:P576 ?end . }
  OPTIONAL { ?item wdt:P131 ?admin . }
  OPTIONAL { ?item wdt:P31 ?type . }
  OPTIONAL { ?item wdt:P18 ?image . }
  OPTIONAL { ?article schema:about ?item ; schema:isPartOf <https://ru.wikipedia.org/> . }
  OPTIONAL { ?item schema:description ?description . FILTER(LANG(?description) = "ru") }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "ru,en,uk,be,pl,lt,lv,et,fi,ro,hy,ka,az,kk,ky,uz,tg,tk,tr,de,sv,fr,nl". }
}
ORDER BY ?item
